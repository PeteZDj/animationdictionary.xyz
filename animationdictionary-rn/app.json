{
  "expo": {
    "name": "Animation Dictionary",
    "slug": "animationdictionary-rn",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "animationdictionary",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F8FAFC",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "xyz.animationdictionary.app"
    },
    "android": {
      "package": "xyz.animationdictionary.app",
      "adaptiveIcon": {
        "backgroundColor": "#0F172A",
        "foregroundImage": "./assets/images/adaptive-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0F172A",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ],
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    }
  }
}
